import { afterEach, beforeEach, describe, vi } from "vitest";
import { createGame, type Game } from "{{gameImport}}";
import { InternalActionType } from "{{internalActionTypeImport}}";
import { clearItems, clearMobs } from "{{testHelpersImport}}/clear";
import {
  expectGameStateConsistent,
  integrityCheckEnabled,
} from "{{testHelpersImport}}/integrity";

describe("{{describeName}}", () => {
  let game: Game;

  beforeEach(() => {
    game = createGame();
    game.dispatch({ type: InternalActionType.INIT });
    clearMobs(game);
    clearItems(game);
  });

  afterEach(() => {
    if (integrityCheckEnabled()) {
      expectGameStateConsistent(game);
    }

    vi.restoreAllMocks();
  });
});
